generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  passwordHash     String
  role             Role            @default(STUDENT)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  attendanceMarked Attendance[]    @relation("MarkedBy")
  logs             AuditLog[]
  notices          Notice[]
  noticeViews      NoticeView[]
  parent           Parent?
  createdExams     ScheduledExam[]
  staff            Staff?
  student          Student?
  teacher          Teacher?
}

model Student {
  id                String             @id @default(uuid())
  admissionNumber   String             @unique
  rollNumber        String?
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            String
  address           String?
  phoneNumber       String?
  userId            String?            @unique
  sectionId         String
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bloodGroup        String?
  city              String?
  parentId          String?
  profileImage      String?
  state             String?
  attendance        Attendance[]
  calculatedResults CalculatedResult[]
  marks             Mark[]
  feeRecords        MonthlyFeeRecord[]
  parent            Parent?            @relation(fields: [parentId], references: [id])
  section           Section            @relation(fields: [sectionId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  submissions       Submission[]
   @@unique([sectionId, rollNumber])
}

model Parent {
  id          String    @id @default(uuid())
  fatherName  String?
  fatherPhone String?
  motherName  String?
  motherPhone String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  userId      String?   @unique
  email       String?
  user        User?     @relation(fields: [userId], references: [id])
  students    Student[]
}

model Teacher {
  id                  String                  @id @default(uuid())
  employeeId          String                  @unique
  qualification       String?
  specialization      String?
  experience          Int?
  joiningDate         DateTime
  designation         String                  @default("Teacher")
  userId              String                  @unique
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  address             String?
  bio                 String?
  dateOfBirth         DateTime?
  email               String?                 @unique
  firstName           String                  @default("")
  gender              String?
  lastName            String                  @default("")
  phone               String?
  status              String                  @default("ACTIVE")
  bloodGroup          String?
  city                String?
  state               String?
  assignments         Assignment[]
  classTeacherOf      Section?                @relation("ClassTeacher")
  gradedSubmissions   Submission[]            @relation("Grader")
  user                User                    @relation(fields: [userId], references: [id])
  teachingAssignments TeacherSectionSubject[]
  timetables          Timetable[]
}

model Staff {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  department  String
  designation String
  joiningDate DateTime
  userId      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AcademicYear {
  id            String         @id @default(uuid())
  name          String
  isCurrent     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  classes       Class[]
  feeComponents FeeComponent[]
  holidays      Holiday[]
}

model Class {
  id                   String                @id @default(uuid())
  name                 String
  academicYearId       String
  assessmentComponents AssessmentComponent[]
  assignments          Assignment[]
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id])
  feeComponents        FeeComponent[]
  scheduledExams       ScheduledExam[]
  sections             Section[]
  subjects             Subject[]
}

model Section {
  id                  String                  @id @default(uuid())
  name                String
  classId             String
  classTeacherId      String?                 @unique
  assignments         Assignment[]
  attendances         Attendance[]
  academicClass       Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher        Teacher?                @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students            Student[]
  teachingAssignments TeacherSectionSubject[]
  timetable           Timetable[]
}

model Subject {
  id                   String                  @id @default(uuid())
  name                 String
  code                 String
  classId              String
  icon                 String?
  assessmentComponents AssessmentComponent[]
  assignments          Assignment[]
  scheduledExams       ScheduledExam[]
  class                Class                   @relation(fields: [classId], references: [id])
  teachingAssignments  TeacherSectionSubject[]
  timetable            Timetable[]
}

model TeacherSectionSubject {
  id        String   @id @default(uuid())
  teacherId String
  sectionId String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId, subjectId])
  @@index([teacherId])
  @@index([sectionId])
  @@index([subjectId])
}

model Timetable {
  id         String    @id @default(uuid())
  day        DayOfWeek
  period     Int
  startTime  String
  endTime    String
  sectionId  String
  subjectId  String?
  teacherId  String?
  breakLabel String?
  color      String?
  isBreak    Boolean   @default(false)
  room       String?
  section    Section   @relation(fields: [sectionId], references: [id])
  subject    Subject?  @relation(fields: [subjectId], references: [id])
  teacher    Teacher?  @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, day, period])
  @@unique([teacherId, day, period])
}

model Attendance {
  id         String           @id @default(uuid())
  date       DateTime         @default(now())
  status     AttendanceStatus
  studentId  String
  markedById String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  sectionId  String?
  markedBy   User             @relation("MarkedBy", fields: [markedById], references: [id])
  section    Section?         @relation(fields: [sectionId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

model Notice {
  id         String         @id @default(uuid())
  title      String
  content    String
  targetType TargetType
  targetId   String?
  priority   NoticePriority @default(STANDARD)
  authorId   String
  createdAt  DateTime       @default(now())
  expiresAt  DateTime?
  category   NoticeCategory @default(ANNOUNCEMENT)
  author     User           @relation(fields: [authorId], references: [id])
  views      NoticeView[]
}

model NoticeView {
  id       String   @id @default(uuid())
  noticeId String
  userId   String
  viewedAt DateTime @default(now())
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
}

model Assignment {
  id          String       @id @default(uuid())
  title       String
  content     String
  fileUrl     String?
  dueDate     DateTime
  maxScore    Int          @default(100)
  subjectId   String
  classId     String
  sectionId   String?
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  class       Class        @relation(fields: [classId], references: [id])
  section     Section?     @relation(fields: [sectionId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  submissions Submission[]
}

model Submission {
  id            String           @id @default(uuid())
  assignmentId  String
  studentId     String
  fileUrl       String?
  content       String?
  submittedAt   DateTime         @default(now())
  status        SubmissionStatus @default(SUBMITTED)
  remarks       String?
  gradedById    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  marksObtained Float?
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  gradedBy      Teacher?         @relation("Grader", fields: [gradedById], references: [id])
  student       Student          @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

model ExamTerm {
  id             String                @id @default(uuid())
  name           String
  createdAt      DateTime              @default(now())
  components     AssessmentComponent[]
  results        CalculatedResult[]
  scheduledExams ScheduledExam[]
}

model ScheduledExam {
  id          String   @id @default(uuid())
  title       String
  syllabus    String?
  examDate    DateTime
  startTime   String?
  endTime     String?
  totalMarks  Float?   @default(100)
  termId      String
  subjectId   String
  classId     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  instruction String?
  class       Class    @relation(fields: [classId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  term        ExamTerm @relation(fields: [termId], references: [id])

  @@index([classId, examDate])
}

model AssessmentComponent {
  id        String        @id @default(uuid())
  name      String
  type      ComponentType @default(THEORY)
  maxMarks  Float
  weightage Float
  termId    String
  subjectId String
  classId   String
  class     Class         @relation(fields: [classId], references: [id])
  subject   Subject       @relation(fields: [subjectId], references: [id])
  term      ExamTerm      @relation(fields: [termId], references: [id])
  marks     Mark[]

  @@index([termId, subjectId, classId])
}

model Mark {
  id                    String              @id @default(uuid())
  studentId             String
  assessmentComponentId String
  marksObtained         Float
  isAbsent              Boolean             @default(false)
  teacherId             String
  updatedAt             DateTime            @updatedAt
  assessment            AssessmentComponent @relation(fields: [assessmentComponentId], references: [id])
  student               Student             @relation(fields: [studentId], references: [id])

  @@unique([studentId, assessmentComponentId])
}

model CalculatedResult {
  id              String   @id @default(uuid())
  studentId       String
  subjectId       String
  termId          String
  finalPercentage Float
  isStale         Boolean  @default(false)
  isComplete      Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  grade           String?
  student         Student  @relation(fields: [studentId], references: [id])
  term            ExamTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId])
}

model GradingScale {
  id         String @id @default(uuid())
  minPercent Float
  maxPercent Float
  grade      String
  gradePoint Float
}

model SchoolConfig {
  id                String      @id @default(uuid())
  reportDisplayMode DisplayMode @default(PERCENTAGE)
  passingPercent    Float       @default(33.0)
}

model FeeComponent {
  id              String       @id @default(uuid())
  classId         String
  feeName         String
  amount          Float
  applicableMonth Int          @default(0)
  updatedAt       DateTime     @updatedAt
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  class           Class        @relation(fields: [classId], references: [id])

  @@unique([classId, academicYearId, feeName, applicableMonth])
}

model MonthlyFeeRecord {
  id          String    @id @default(uuid())
  studentId   String
  month       Int
  year        Int
  amountDue   Float
  status      FeeStatus @default(PENDING)
  paymentMode String?
  referenceNo String?
  remarks     String?
  verifiedBy  String?
  updatedAt   DateTime  @updatedAt
  student     Student   @relation(fields: [studentId], references: [id])

  @@unique([studentId, month, year])
}

model Holiday {
  id             String          @id @default(uuid())
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  type           HolidayType     @default(GAZETTED)
  appliesTo      HolidayAudience @default(ALL)
  academicYearId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])

  @@index([startDate, endDate])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  FINANCE
  PARENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum NoticeCategory {
  ANNOUNCEMENT
  ACADEMIC
  HOLIDAY
  EXAM
  SCHOOL_EVENT
  STAFF_CIRCULAR
}

enum NoticePriority {
  STANDARD
  HIGH
  URGENT
}

enum TargetType {
  GLOBAL
  ROLE
  CLASS
  SECTION
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

enum DisplayMode {
  PERCENTAGE
  CGPA
  GRADE
}

enum ComponentType {
  THEORY
  PRACTICAL
  INTERNAL
  VIVA
}

enum FeeStatus {
  PENDING
  SUBMITTED
  VERIFIED
  BOUNCED
}

enum HolidayType {
  GAZETTED
  INTERNAL
  EMERGENCY
}

enum HolidayAudience {
  ALL
  STUDENT
  STAFF
}
